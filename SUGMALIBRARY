function Library:UIDelete()
	if self.ScreenGui then self.ScreenGui:Destroy();self.ScreenGui=nil end
	if self.Notifications then if self.Notifications.Parent then self.Notifications.Parent:Destroy() end;self.Notifications=nil end
end
function Library:SaveConfig(name)
	local n=(name or self.Flags["ConfigName"] or "config")..".json"
	if writefile then writefile(n,HttpService:JSONEncode(self.Flags));self:Notify("Config","Saved to "..n,3) else self:Notify("Error","Your executor does not support writefile.",3) end
end
function Library:LoadConfig(name)
	local n=(name or self.Flags["ConfigName"] or "config")..".json"
	if isfile and isfile(n) then
		local s,r=pcall(function() return HttpService:JSONDecode(readfile(n)) end)
		if s and type(r)=="table" then for k,v in pairs(r) do self.Flags[k]=v end;self:Update();self:Notify("Config","Successfully loaded "..n,3)
		else self:Notify("Error","Failed to parse config file.",3) end
	else self:Notify("Error","File not found!",3) end
end
